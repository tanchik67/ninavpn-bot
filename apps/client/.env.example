EXPO_PUBLIC_API_URL=https://ninavpn.store
# Google OAuth Web Client ID (same ID listed in API GOOGLE_CLIENT_IDS)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Optional: native Android/iOS OAuth client IDs (if created in Google Cloud)
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Telegram bot username without @
EXPO_PUBLIC_TELEGRAM_BOT_USERNAME=
# Hosted Login Widget page (must be on BotFather Login domain)
EXPO_PUBLIC_TG_LOGIN_URL=https://ninavpn.store/tg-login.html
# Native Google sign-in bridge (Authorized redirect URI for Web client)
EXPO_PUBLIC_GOOGLE_LOGIN_URL=https://ninavpn.store/google-login.html
